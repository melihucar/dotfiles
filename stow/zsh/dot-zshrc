# ~/.zshrc — interactive shell. Machine-specific stuff & secrets go in ~/.zshrc.local (untracked).

ZCONF="$XDG_CONFIG_HOME/zsh"

# ---- history ---------------------------------------------------------------
HISTFILE="$XDG_STATE_HOME/zsh/history"
[[ -d ${HISTFILE:h} ]] || mkdir -p "${HISTFILE:h}"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE \
       HIST_REDUCE_BLANKS HIST_VERIFY

# ---- options ---------------------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT INTERACTIVE_COMMENTS \
       NO_BEEP EXTENDED_GLOB
WORDCHARS=${WORDCHARS//[\/]}   # ctrl-w stops at /

# ---- tools on PATH (must come before completion) ---------------------------
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# ---- plugins (no framework; cloned on first run) ---------------------------
source "$ZCONF/plugins.zsh"

# ---- completion ------------------------------------------------------------
fpath=("$ZCONF/completions" $fpath)
autoload -Uz compinit
_zcomp="$XDG_CACHE_HOME/zsh/zcompdump"
[[ -d ${_zcomp:h} ]] || mkdir -p "${_zcomp:h}"
# full security check at most once a day, cached otherwise
if [[ -n $_zcomp(#qN.mh+24) || ! -f $_zcomp ]]; then compinit -d "$_zcomp"; else compinit -C -d "$_zcomp"; fi
unset _zcomp
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"

# ---- keys ------------------------------------------------------------------
bindkey -e
autoload -Uz edit-command-line; zle -N edit-command-line
bindkey '^x^e' edit-command-line          # open current command in $EDITOR
bindkey '^[[1;5C' forward-word            # ctrl-right
bindkey '^[[1;5D' backward-word           # ctrl-left
bindkey '^ ' autosuggest-accept           # ctrl-space accepts suggestion

# ---- integrations ----------------------------------------------------------
command -v fzf      >/dev/null && source <(fzf --zsh)          # ctrl-r, ctrl-t, alt-c
command -v zoxide   >/dev/null && eval "$(zoxide init zsh --cmd cd)"
command -v starship >/dev/null && eval "$(starship init zsh)"

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border=rounded \
  --color=fg:#908caa,bg:-1,hl:#ebbcba,fg+:#e0def4,bg+:#26233a,hl+:#ebbcba \
  --color=border:#403d52,header:#31748f,gutter:-1,spinner:#f6c177,info:#9ccfd8 \
  --color=pointer:#c4a7e7,marker:#eb6f92,prompt:#908caa"

source "$ZCONF/aliases.zsh"
source "$ZCONF/functions.zsh"

# syntax highlighting must be sourced last
[[ -r $ZPLUGDIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source "$ZPLUGDIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
